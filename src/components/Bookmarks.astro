---
---
<form id="add-bookmark">
  <div class="field">
    <label for="url">Link to save</label>
    <input
      id="url"
      name="url"
      type="text"
      inputmode="url"
      autocomplete="off"
      spellcheck="false"
      placeholder="https://example.com"
      required
    />
  </div>
  <button type="submit">Add bookmark</button>
</form>

<p class="hint">Paste a URL with or without <code>https://</code> to generate its short <code>mona-</code> slug.</p>

<p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

<div id="list-header" hidden>
  <h2 class="list-title">Saved bookmarks</h2>
  <button id="clear-all" type="button" class="clear">Clear all</button>
</div>

<ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite">
  <!-- Bookmarks render here in the browser. -->
</ul>

<script>
  import { formatBookmark, generateSlug, loadBookmarks, normalizeUrl } from './bookmarks.js';

  const STORAGE_KEY = 'mona-bookmarks';
  const form = document.getElementById('add-bookmark');
  const input = document.getElementById('url');
  const list = document.getElementById('bookmark-list');
  const emptyState = document.getElementById('empty-state');
  const listHeader = document.getElementById('list-header');
  const clearAll = document.getElementById('clear-all');
  let bookmarks = [];
  try {
    bookmarks = loadBookmarks(localStorage.getItem(STORAGE_KEY));
  } catch {
    bookmarks = [];
  }

  function persist() {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(bookmarks));
    } catch {
      // Storage can be unavailable in private or restricted browsing contexts.
    }
  }

  function render() {
    list.replaceChildren();
    bookmarks.forEach((bookmark) => {
      const item = document.createElement('li');
      item.className = 'bookmark';

      const link = document.createElement('a');
      link.className = 'url';
      link.href = bookmark.url;
      link.target = '_blank';
      link.rel = 'noreferrer';
      link.textContent = bookmark.url;

      const separator = document.createElement('span');
      separator.className = 'separator';
      separator.textContent = ' :: ';

      const slug = document.createElement('code');
      slug.className = 'slug';
      slug.textContent = bookmark.slug;

      const copy = document.createElement('button');
      copy.className = 'copy';
      copy.type = 'button';
      copy.textContent = 'Copy';
      copy.addEventListener('click', async () => {
        await navigator.clipboard.writeText(bookmark.slug);
        copy.textContent = 'Copied';
        setTimeout(() => { copy.textContent = 'Copy'; }, 1200);
      });

      item.setAttribute('aria-label', formatBookmark(bookmark));
      item.append(link, separator, slug, copy);
      list.append(item);
    });

    const hasBookmarks = bookmarks.length > 0;
    emptyState.hidden = hasBookmarks;
    listHeader.hidden = !hasBookmarks;
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    try {
      const url = normalizeUrl(input.value);
      bookmarks = [{ url, slug: generateSlug(Date.now()) }, ...bookmarks];
      persist();
      render();
      form.reset();
      input.focus();
    } catch (error) {
      input.setCustomValidity(error instanceof Error ? error.message : 'Enter a valid URL.');
      input.reportValidity();
      input.addEventListener('input', () => input.setCustomValidity(''), { once: true });
    }
  });

  clearAll?.addEventListener('click', () => {
    if (bookmarks.length && confirm('Clear all saved bookmarks?')) {
      bookmarks = [];
      try {
        localStorage.removeItem(STORAGE_KEY);
      } catch {
        // Storage can be unavailable in private or restricted browsing contexts.
      }
      render();
    }
  });

  render();
</script>
